# Copy to .env; restart the service after changing configuration.
# All paths are relative to the project root, not the current terminal directory.
LABAGENT_DATA_DIR=data
LABAGENT_HOST=127.0.0.1
LABAGENT_PORT=8000
# Required if exposing the API beyond loopback. The UI asks for this token.
LABAGENT_ACCESS_TOKEN=
LABAGENT_EVIDENCE_TTL_SECONDS=300
LABAGENT_MIN_CONFIDENCE=0.85
LABAGENT_HTTP_TIMEOUT=45
LABAGENT_MAX_TOOL_ROUNDS=4

# rules = explicit deterministic assistant (no pretend LLM); api = actual model tool calling.
LABAGENT_CHAT_PROVIDER=rules
LABAGENT_LLM_BASE_URL=
LABAGENT_LLM_API_KEY=
LABAGENT_LLM_MODEL=

# disabled | vlm | onnx. Nothing is downloaded automatically.
LABAGENT_VISION_PROVIDER=disabled
LABAGENT_VLM_BASE_URL=
LABAGENT_VLM_API_KEY=
LABAGENT_VLM_MODEL=
# Must be a custom YOLOv8 detect export, raw [1,4+C,N] float32 (no NMS/objectness).
LABAGENT_ONNX_MODEL=
LABAGENT_ONNX_LABELS=
LABAGENT_ONNX_SIZE=640
# CPU only by default; a CIX NPU runtime is NOT automatically provided by this setting.
LABAGENT_ONNX_PROVIDERS=CPUExecutionProvider

# disabled | tesseract | vlm. OCR is limited to an explicitly selected meter display ROI.
LABAGENT_OCR_PROVIDER=disabled
LABAGENT_TESSERACT_COMMAND=tesseract
# Normalized x,y,width,height. Empty = UI must select ROI before OCR.
LABAGENT_METER_ROI=

# Optional speech service, Chat-Completions-compatible service's audio/transcriptions endpoint.
LABAGENT_ASR_BASE_URL=
LABAGENT_ASR_API_KEY=
LABAGENT_ASR_MODEL=
